{
  "name": "tarkov-map-share",
  "version": "0.0.0",
  "private": true,
  "description": "多人实时地图共享工具（纯协作辅助，不做任何游戏进程交互）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "test:e2e": "npm run --workspaces --if-present test:e2e",
    "lint": "npm run --workspaces --if-present lint",
    "dev:server": "npm run --workspace @tarkov-map-share/server --if-present dev",
    "dev:desktop": "npm run --workspace @tarkov-map-share/desktop --if-present dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
